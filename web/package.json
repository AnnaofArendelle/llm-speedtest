{
  "name": "llm-speedtest-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "screenshots": "playwright test -c tests/playwright.config.ts",
    "e2e": "playwright test -c tests/playwright.e2e.config.ts"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@mui/x-data-grid": "8.29.5",
    "@tanstack/react-query": "5.105.1",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "framer-motion": "14.9.0",
    "i18next": "26.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.10",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.5.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
